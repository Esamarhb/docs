    <html dir="rtl" lang="ar">
    <head>
        <meta charset="UTF-8">
        <style>
            @page { size: A4 portrait; margin: 15mm; }
            * { box-sizing: border-box; margin: 0; padding: 0; }
            body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; direction: rtl; background: white; padding: 5mm; }
            .header { text-align: center; margin-bottom: 15px; padding-bottom: 10px; border-bottom: 3px solid #2c3e50; }
            .header h1 { font-size: 22px; color: #2c3e50; margin: 0; }
            .header .subtitle { font-size: 14px; color: #555; margin-top: 3px; }
            .header .meta { font-size: 10px; color: #999; margin-top: 3px; }
            .break-info { text-align: center; font-size: 10px; color: #e67e22; margin: 5px 0 15px 0; padding: 5px; background: #fef9e7; border-radius: 6px; border: 1px dashed #f39c12; }
            .section { margin-bottom: 20px; page-break-inside: avoid; }
            .section-title { font-size: 14px; font-weight: 600; color: #2c3e50; margin-bottom: 6px; padding: 4px 10px; background: #ecf0f1; border-radius: 6px; }
            table { width: 100%; border-collapse: collapse; font-size: 10px; margin: 3px 0; }
            th { background: #2c3e50; color: white; padding: 5px 3px; border: 1px solid #34495e; font-weight: 600; text-align: center; }
            td { padding: 4px 3px; border: 1px solid #ddd; text-align: center; vertical-align: middle; min-height: 22px; }
            .day-cell { font-weight: 600; background: #f8f9fa; font-size: 10px; }
            .subject-cell { padding: 2px 5px; border-radius: 3px; font-weight: 500; display: inline-block; font-size: 9px; }
            .empty-cell { color: #ccc; font-size: 9px; }
            .time-cell { font-size: 8px; color: #999; font-weight: normal; }
            .break-row td { background: #fef9e7 !important; color: #e67e22; font-weight: 600; font-size: 9px; border: 1px dashed #f39c12; }
            .footer { text-align: center; color: #999; font-size: 9px; margin-top: 15px; padding-top: 8px; border-top: 1px solid #ecf0f1; }
            @media print { body { padding: 5mm; } }
        </style>
